  "faq": [
    {
      "q": "Who can sign in to the system?",
      "a": "Only officers, teachers and students with an account created by their authority. Citizens use the public services without signing in."
    },
    {
      "q": "How do I track my admission application?",
      "a": "Use Track application with the reference number you received after submitting, for example ADM-2026-104233."
    },
    {
      "q": "Can anyone verify a certificate?",
      "a": "Organizations register and pay before verifying a certificate or license number. Free public lookup is TBD — requires client confirmation."
    },
    {
      "q": "I forgot my password. What should I do?",
      "a": "Use Forgot password on the sign-in page. Reset instructions are sent to your registered contact (channel TBD)."
    }
  ],
